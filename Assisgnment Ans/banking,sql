CREATE TABLE IF NOT EXISTS fixed_deposit (
  fd_id INT PRIMARY KEY,
  customer_id INT,
  principal DECIMAL(14,2),
  rate DECIMAL(5,2), -- e.g., 5.5
  years INT
);

CREATE TABLE IF NOT EXISTS fd_history (
  hist_id BIGINT AUTO_INCREMENT PRIMARY KEY,
  fd_id INT,
  maturity_amount DECIMAL(14,2),
  calc_date DATE DEFAULT (CURDATE())
);

DELIMITER $$
CREATE PROCEDURE calculate_fd_interest(IN p_fd_id INT)
BEGIN
  DECLARE v_principal DECIMAL(14,2);
  DECLARE v_rate DECIMAL(5,2);
  DECLARE v_years INT;
  DECLARE v_maturity DECIMAL(14,2);

  SELECT principal, rate, years INTO v_principal, v_rate, v_years
  FROM fixed_deposit WHERE fd_id = p_fd_id;

  IF v_principal IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'FD not found';
  END IF;

  SET v_maturity = v_principal + (v_principal * v_rate/100.0 * v_years);
  INSERT INTO fd_history(fd_id, maturity_amount) VALUES(p_fd_id, ROUND(v_maturity,2));
END$$
DELIMITER ;
